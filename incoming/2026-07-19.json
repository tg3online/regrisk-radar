[\n  {\n    \"id\": \"2026-07-19-kalshi-sdny-injunction-appeal\",\n    \"date\": \"2026-07-19\",\n    \"published\": \"2026-07-15T00:00:00Z\",\n    \"issuing_body\": \"KalshiEX LLC / U.S. District Court, Southern District of New York (No. 25-cv-08846-AT, Judge Analisa Torres)\",\n    \"title\": \"Kalshi Seeks Emergency Injunction Pending Appeal in SDNY Case; New York Agrees to No-Enforcement Standstill Through July 30, Kalshi to Seek Second Circuit Relief July 23\",\n    \"facts\": \"On July 15, 2026, KalshiEX LLC filed a letter motion in KalshiEX LLC v. Williams (No. 25-cv-08846-AT, S.D.N.Y., Judge Analisa Torres) seeking an emergency injunction pending appeal of the court's prior denial of a preliminary injunction. The filing states that defendants (New York state officials) agreed not to bring an enforcement action against Kalshi under New York law through July 30, 2026, while the motion is pending. If the court does not grant relief, Kalshi intends to seek a Second Circuit injunction pending appeal on July 23, 2026. The motion argues that the case presents serious legal questions about whether the Commodity Exchange Act preempts state gambling laws, noting the Third Circuit ruled for Kalshi in KalshiEX LLC v. Flaherty (172 F.4th 220, 3d Cir. 2026), while a separate federal preemption suit (CFTC v. New York, No. 26-cv-3404, S.D.N.Y., Judge Marrero) is pending in the same district. Source: primary court document (Docket 110, letter motion filed by Grant Mainland, Milbank) retrieved via CourtListener/RECAP.\",\n    \"source_url\": \"https://storage.courtlistener.com/recap/gov.uscourts.nysd.651836/gov.uscourts.nysd.651836.110.0.pdf\",\n    \"source_label\": \"KalshiEX LLC v. Williams, No. 25-cv-08846-AT (S.D.N.Y.) — Motion for Injunction Pending Appeal, filed July 15, 2026 (via CourtListener/RECAP, Docket 110)\",\n    \"tags\": [\"prediction-markets\", \"kalshi\", \"preemption\", \"sdny\", \"second-circuit\", \"injunction\", \"cftc\", \"state-enforcement\"],\n    \"source_type\": \"primary_source\",\n    \"primary_source_status\": \"retrieved\",\n    \"relevant_to\": \"Prediction-market platforms, CFTC-registered exchanges, gaming operators with New York exposure\"\n  },\n  {\n    \"id\": \"2026-07-19-nc-sweepstakes-supreme-court-amicus\",\n    \"date\": \"2026-07-19\",\n    \"published\": \"2026-07-16T00:00:00Z\",\n    \"issuing_body\": \"North Carolina Supreme Court (amicus filers: NC Sheriffs' Association, NC Association of Chiefs of Police, NC Conference of District Attorneys, NC Family Policy Council)\",\n    \"title\": \"NC Law Enforcement Groups and Family Policy Council File Amicus Briefs Against Video Sweepstakes Operator at NC Supreme Court; Oral Arguments Set for September 2026\",\n    \"facts\": \"On July 16, 2026, the North Carolina Sheriffs' Association, North Carolina Association of Chiefs of Police, and North Carolina Conference of District Attorneys filed a joint amicus brief in No Limit Games v. Sheriff of Robeson County at the North Carolina Supreme Court, urging the court to uphold the Court of Appeals' 2-1 December 2024 ruling that No Limit Games' video sweepstakes devices violate N.C. Gen. Stat. § 14-306.4. The North Carolina Family Policy Council filed a separate amicus brief the same day. Oral arguments are scheduled for September 2026. The case involves whether No Limit's sweepstakes system — which includes an optional skill-based 'Instant Reveal' function — falls outside the statutory prohibition on video games of chance used in the entry or reveal of sweepstakes prizes. A trial court granted an injunction in No Limit's favor in 2023; the Court of Appeals reversed 2-1 in December 2024.\",\n    \"source_url\": \"https://www.carolinajournal.com/video-sweepstakes-case-at-top-nc-court-attracts-outside-interest/\",\n    \"source_label\": \"Carolina Journal — Video sweepstakes case at top NC court attracts outside interest (July 16, 2026); amicus briefs filed at ncappellatecourts.org\",\n    \"tags\": [\"sweepstakes\", \"gaming\", \"nc-supreme-court\", \"skill-gaming\", \"amicus\", \"state-enforcement\"],\n    \"source_type\": \"coverage_reporting_filing\",\n    \"primary_source_status\": \"cited_by_coverage_not_retrieved\",\n    \"relevant_to\": \"Sweepstakes casino operators, skill-gaming platforms, gaming companies with North Carolina exposure\"\n  },\n  {\n    \"id\": \"2026-07-19-water-street-labs-cftc-dcm\",\n    \"date\": \"2026-07-19\",\n    \"published\": \"2026-07-17T08:42:00Z\",\n    \"issuing_body\": \"Commodity Futures Trading Commission (CFTC)\",\n    \"title\": \"CFTC Approves Water Street Labs, LLC as New Designated Contract Market for Fully Collateralized Event Contract Products\",\n    \"facts\": \"The CFTC approved Water Street Labs, LLC's application to become a designated contract market (DCM), as reported by Gambling Insider and DeFiRate (July 17, 2026). Both reports attribute the approval to an official CFTC designation order. According to the reports, Water Street Labs plans to offer fully collateralized products through both a central limit order book and a parimutuel auction model. No formal CFTC press release number was located on cftc.gov corresponding to this designation at time of publication.\",\n    \"source_url\": \"https://www.gamblinginsider.com/news/175442/prediction-markets-weekly-roundup-court-battles-cftc-kalshi-products\",\n    \"source_label\": \"Gambling Insider — Prediction Markets Weekly Roundup (July 17, 2026), corroborated by DeFiRate\",\n    \"tags\": [\"prediction-markets\", \"cftc\", \"dcm\", \"event-contracts\", \"fintech\", \"water-street-labs\"],\n    \"source_type\": \"media_coverage\",\n    \"primary_source_status\": \"cited_by_coverage_not_retrieved\",\n    \"relevant_to\": \"Prediction-market platforms, event-contract exchanges, fintech operators in the derivatives and event-contracts space\"\n  }\n]\n