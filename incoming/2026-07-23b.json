{\n  "drop_date": "2026-07-23",\n  "drop_suffix": "b",\n  "source_batch_id": "batch_2026-07-23",\n  "items": [\n    {\n      "id": "2026-07-23-clarity-act-senate-passage-likely-miss",\n      "date": "2026-07-23",\n      "published": "2026-07-23T20:16:00Z",\n      "issuing_body": "U.S. Senate (reported)",\n      "title": "Senate Majority Leader Thune signals CLARITY Act likely to miss pre-recess floor vote; Russia sanctions bill takes priority",\n      "facts": "Senate Majority Leader John Thune told reporters on July 23, 2026 that the Digital Asset Market CLARITY Act is unlikely to receive a floor vote before the August 7 congressional recess, saying: 'I would like to at least get Clarity started. We’ll see where the votes are.' Senate leadership plans to prioritize the Russia sanctions bill (Sen. Lindsey Graham) on the floor the following week, leaving insufficient floor time for the 60-vote cloture process. White House crypto adviser Bo Hines indicated the first week of August (Aug 1-7) may still be possible. The bill faces bipartisan opposition on the ethics provision sunset date and stablecoin yield provisions. Corroborated by Yahoo Finance, CryptoTimes, and The Defiant (all July 23, 2026). No official Senate floor schedule was published on senate.gov as of this report.",\n      "source_url": "https://www.coindesk.com/policy/2026/07/23/clarity-act-expected-to-miss-its-window-before-congress-summer-break-leadership-says",\n      "source_label": "CoinDesk",\n      "tags": ["legislation", "clarity-act", "congress", "crypto", "market-structure", "senate", "floor-timing"],\n      "source_type": "media_coverage",\n      "primary_source_status": "cited_by_coverage_not_retrieved",\n      "relevant_to": "Crypto operators, exchanges, token issuers, stablecoin issuers, and DeFi platforms planning for the federal market-structure framework — pre-recess passage now unlikely; first week of August is the remaining window before August 7 recess"\n    },\n    {\n      "id": "2026-07-23-sec-coinbase-foia-settlement-gensler-texts",\n      "date": "2026-07-23",\n      "published": "2026-07-23T00:00:00Z",\n      "issuing_body": "U.S. Securities and Exchange Commission",\n      "title": "SEC agrees to pay $150,000 and produce records to settle Coinbase FOIA lawsuit; settlement confirms Gensler texts deleted 2022-2023 and 21 officials’ phones wiped",\n      "facts": "The SEC and History Associates Inc. (acting on behalf of Coinbase) filed a joint status report on July 22, 2026 in History Associates Inc. v. SEC (D.D.C. No. 1:24-cv-01766), settling a FOIA lawsuit over SEC records on Ethereum and Gensler-era communications. Settlement terms: SEC pays $150,000 in legal fees; SEC produces all remaining responsive documents; case dismissed upon completion. The lawsuit (filed June 2024) compelled production of thousands of SEC records. The production confirmed that SEC Chair Gensler’s text messages were deleted for October 2022 through September 2023 and that 21 senior SEC officials’ phones were wiped. Two previously withheld documents were released in settlement. Coinbase CEO Brian Armstrong called it 'a huge win for crypto.' Reported by CoinDesk, CoinTelegraph, CryptoSlate, and FinanceFeeds (all July 23, 2026); underlying joint status report filed in PACER.",\n      "source_url": "https://www.coindesk.com/policy/2026/07/23/sec-agrees-to-end-lawsuit-over-missing-ethereum-records-will-pay-usd150-000-in-fees",\n      "source_label": "CoinDesk",\n      "tags": ["sec", "foia", "coinbase", "ethereum", "gensler", "record-keeping"],\n      "source_type": "coverage_reporting_filing",\n      "primary_source_status": "cited_by_coverage_not_retrieved",\n      "relevant_to": "Crypto platforms and exchanges subject to prior SEC enforcement or investigation 2022-2023; FOIA practitioners monitoring SEC records and institutional accountability"\n    }\n  ]\n}